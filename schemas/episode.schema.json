{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verum:episode:0.7.0",
  "title": "episode (hidden, evaluator-only)",
  "x-status": "backend-proposed",
  "description": "Proposed by the backend for review by the schema owner. Evaluator-only truth data: never served to agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "episode_id",
    "hidden",
    "scenario_id",
    "seed",
    "config_hash",
    "lockfile_hash",
    "solver_version",
    "dataset_tier",
    "step_size_s",
    "duration_s",
    "temperature_c",
    "fitting_profile",
    "healthy_envelope",
    "fluid_density_kg_m3",
    "initial_tank_levels_m",
    "tolerances",
    "pipe_inventory_constant",
    "status",
    "atmosphere_stratum",
    "atmosphere_pa_abs",
    "demand_process",
    "events_evaluated",
    "validity_windows",
    "protection_crossings",
    "volatility_class",
    "fault_instance_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.7\\.[0-9]+$"
    },
    "dataset": {
      "const": "episode"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "hidden": {
      "const": true
    },
    "scenario_id": {
      "type": "string"
    },
    "fault_instance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Hidden. Instance identifiers of the injected faults, in the order of the fault_truth rows."
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lockfile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "solver_version": {
      "type": "string"
    },
    "dataset_tier": {
      "enum": [
        "analytic_verification",
        "restricted_benchmark"
      ]
    },
    "step_size_s": {
      "type": "number"
    },
    "duration_s": {
      "type": "number"
    },
    "temperature_c": {
      "type": "number"
    },
    "fitting_profile": {
      "type": "string"
    },
    "healthy_envelope": {
      "type": "boolean"
    },
    "fluid_density_kg_m3": {
      "type": "number"
    },
    "initial_tank_levels_m": {
      "type": "object"
    },
    "tolerances": {
      "type": "object"
    },
    "pipe_inventory_constant": {
      "const": true
    },
    "status": {
      "enum": [
        "completed",
        "rejected"
      ]
    },
    "atmosphere_stratum": {
      "enum": [
        "coastal",
        "inland"
      ]
    },
    "atmosphere_pa_abs": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "demand_process": {
      "type": "boolean"
    },
    "events_evaluated": {
      "type": "integer",
      "minimum": 0
    },
    "validity_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "window_id",
          "kind",
          "element_id",
          "t_start_s",
          "t_end_s",
          "reason",
          "ratio",
          "round_trip_s"
        ],
        "properties": {
          "window_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "element_id": {
            "type": "string"
          },
          "t_start_s": {
            "type": "number",
            "minimum": 0
          },
          "t_end_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "ratio": {
            "type": [
              "number",
              "null"
            ]
          },
          "round_trip_s": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "protection_crossings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t_sim_s",
          "tank",
          "threshold",
          "level_m"
        ],
        "properties": {
          "t_sim_s": {
            "type": "number",
            "minimum": 0
          },
          "tank": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          },
          "level_m": {
            "type": "number"
          }
        }
      }
    },
    "volatility_class": {
      "enum": [
        "RVP_9_0",
        "RVP_9_5",
        "RVP10"
      ]
    }
  }
}
