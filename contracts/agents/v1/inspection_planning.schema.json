{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verum:agents:v1:inspection_planning",
  "title": "Inspection Planning interface v1",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diagnosis_report": {
          "anyOf": [
            {
              "$ref": "urn:verum:agents:v1:diagnostic_reasoning#/$defs/response"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/catalog_action"
          }
        },
        "catalog_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observations": {
          "anyOf": [
            {
              "$ref": "urn:verum:agents:v1:common#/$defs/observations"
            },
            {
              "type": "null"
            }
          ]
        },
        "constraint_checks": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/check"
          }
        },
        "budget": {
          "$ref": "urn:verum:agents:v1:common#/$defs/budget"
        },
        "target_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/asset"
          }
        },
        "workflow_requests": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:inspection_request:0.5.0"
          }
        }
      },
      "required": [
        "diagnosis_report",
        "catalog",
        "catalog_evidence_ids",
        "observations",
        "constraint_checks",
        "budget",
        "target_asset_ids",
        "assets",
        "workflow_requests"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "action_id": {
                "enum": [
                  "ACT-INSP-01",
                  "ACT-INSP-02",
                  "ACT-INSP-03",
                  "ACT-INSP-04",
                  "ACT-INSP-05",
                  "ACT-INSP-06",
                  "ACT-INSP-07"
                ]
              },
              "target_asset": {
                "type": "string",
                "minLength": 1
              },
              "addresses_hypothesis_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "feasibility": {
                "enum": [
                  "eligible_for_human_review",
                  "blocked",
                  "unknown"
                ]
              },
              "precondition_checks": {
                "type": "array",
                "items": {
                  "$ref": "urn:verum:agents:v1:common#/$defs/check"
                }
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "duration_min": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "expected_information_gain_bits": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "information_gain_method_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "option_id",
              "action_id",
              "target_asset",
              "addresses_hypothesis_ids",
              "feasibility",
              "precondition_checks",
              "cost_usd",
              "duration_min",
              "expected_information_gain_bits",
              "information_gain_method_id",
              "limitations",
              "evidence_ids"
            ]
          }
        },
        "selection_policy_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_option_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dispatch_authorized": {
          "const": false
        }
      },
      "required": [
        "options",
        "selection_policy_id",
        "recommended_option_id",
        "dispatch_authorized"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "request"
        },
        "agent": {
          "const": "inspection_planning"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "urn:verum:agents:v1:common#/$defs/context"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/evidence"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "diagnosis_report": {
              "anyOf": [
                {
                  "$ref": "urn:verum:agents:v1:diagnostic_reasoning#/$defs/response"
                },
                {
                  "type": "null"
                }
              ]
            },
            "catalog": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:agents:v1:common#/$defs/catalog_action"
              }
            },
            "catalog_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "observations": {
              "anyOf": [
                {
                  "$ref": "urn:verum:agents:v1:common#/$defs/observations"
                },
                {
                  "type": "null"
                }
              ]
            },
            "constraint_checks": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:agents:v1:common#/$defs/check"
              }
            },
            "budget": {
              "$ref": "urn:verum:agents:v1:common#/$defs/budget"
            },
            "target_asset_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "assets": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:agents:v1:common#/$defs/asset"
              }
            },
            "workflow_requests": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:inspection_request:0.5.0"
              }
            }
          },
          "required": [
            "diagnosis_report",
            "catalog",
            "catalog_evidence_ids",
            "observations",
            "constraint_checks",
            "budget",
            "target_asset_ids",
            "assets",
            "workflow_requests"
          ]
        }
      },
      "required": [
        "interface_version",
        "message_type",
        "agent",
        "request_id",
        "context",
        "evidence",
        "input"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "response"
        },
        "agent": {
          "const": "inspection_planning"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "urn:verum:agents:v1:common#/$defs/context"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "feature_profile_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version",
            "artifact_sha256",
            "feature_profile_id"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "degraded",
            "insufficient_evidence",
            "error"
          ]
        },
        "consumed_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/issue"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "advisory_only": {
          "const": true
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "option_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "action_id": {
                        "enum": [
                          "ACT-INSP-01",
                          "ACT-INSP-02",
                          "ACT-INSP-03",
                          "ACT-INSP-04",
                          "ACT-INSP-05",
                          "ACT-INSP-06",
                          "ACT-INSP-07"
                        ]
                      },
                      "target_asset": {
                        "type": "string",
                        "minLength": 1
                      },
                      "addresses_hypothesis_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      },
                      "feasibility": {
                        "enum": [
                          "eligible_for_human_review",
                          "blocked",
                          "unknown"
                        ]
                      },
                      "precondition_checks": {
                        "type": "array",
                        "items": {
                          "$ref": "urn:verum:agents:v1:common#/$defs/check"
                        }
                      },
                      "cost_usd": {
                        "type": "number",
                        "minimum": 0
                      },
                      "duration_min": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "expected_information_gain_bits": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "information_gain_method_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "limitations": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "evidence_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "option_id",
                      "action_id",
                      "target_asset",
                      "addresses_hypothesis_ids",
                      "feasibility",
                      "precondition_checks",
                      "cost_usd",
                      "duration_min",
                      "expected_information_gain_bits",
                      "information_gain_method_id",
                      "limitations",
                      "evidence_ids"
                    ]
                  }
                },
                "selection_policy_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "recommended_option_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dispatch_authorized": {
                  "const": false
                }
              },
              "required": [
                "options",
                "selection_policy_id",
                "recommended_option_id",
                "dispatch_authorized"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "interface_version",
        "message_type",
        "agent",
        "request_id",
        "report_id",
        "context",
        "implementation",
        "status",
        "consumed_evidence_ids",
        "issues",
        "limitations",
        "advisory_only",
        "result"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "degraded"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "option_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action_id": {
                          "enum": [
                            "ACT-INSP-01",
                            "ACT-INSP-02",
                            "ACT-INSP-03",
                            "ACT-INSP-04",
                            "ACT-INSP-05",
                            "ACT-INSP-06",
                            "ACT-INSP-07"
                          ]
                        },
                        "target_asset": {
                          "type": "string",
                          "minLength": 1
                        },
                        "addresses_hypothesis_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        },
                        "feasibility": {
                          "enum": [
                            "eligible_for_human_review",
                            "blocked",
                            "unknown"
                          ]
                        },
                        "precondition_checks": {
                          "type": "array",
                          "items": {
                            "$ref": "urn:verum:agents:v1:common#/$defs/check"
                          }
                        },
                        "cost_usd": {
                          "type": "number",
                          "minimum": 0
                        },
                        "duration_min": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "expected_information_gain_bits": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "information_gain_method_id": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "limitations": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "evidence_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "option_id",
                        "action_id",
                        "target_asset",
                        "addresses_hypothesis_ids",
                        "feasibility",
                        "precondition_checks",
                        "cost_usd",
                        "duration_min",
                        "expected_information_gain_bits",
                        "information_gain_method_id",
                        "limitations",
                        "evidence_ids"
                      ]
                    }
                  },
                  "selection_policy_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "recommended_option_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "dispatch_authorized": {
                    "const": false
                  }
                },
                "required": [
                  "options",
                  "selection_policy_id",
                  "recommended_option_id",
                  "dispatch_authorized"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "insufficient_evidence",
                  "error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
