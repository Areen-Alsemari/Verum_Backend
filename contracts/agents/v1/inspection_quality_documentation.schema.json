{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verum:agents:v1:inspection_quality_documentation",
  "title": "Inspection Quality & Documentation interface v1",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inspection_results": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/inspection_result"
          }
        },
        "result_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "catalog": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/catalog_action"
          }
        },
        "catalog_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "process_coverage": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/coverage"
          }
        },
        "observations": {
          "anyOf": [
            {
              "$ref": "urn:verum:agents:v1:common#/$defs/observations"
            },
            {
              "type": "null"
            }
          ]
        },
        "inspection_requests": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:inspection_request:0.5.0"
          }
        }
      },
      "required": [
        "inspection_results",
        "result_evidence_ids",
        "catalog",
        "catalog_evidence_ids",
        "process_coverage",
        "observations",
        "inspection_requests"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "result_id": {
                "type": "string",
                "minLength": 1
              },
              "checks": {
                "type": "array",
                "items": {
                  "$ref": "urn:verum:agents:v1:common#/$defs/check"
                }
              },
              "measurement_usable": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scope_supported": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "equipment_condition_confirmed": {
                "const": false
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "result_id",
              "checks",
              "measurement_usable",
              "scope_supported",
              "equipment_condition_confirmed",
              "evidence_ids"
            ]
          }
        },
        "observed_quality": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tag_id": {
                "type": "string",
                "minLength": 1
              },
              "missing_samples": {
                "type": "integer",
                "minimum": 0
              },
              "non_good_samples": {
                "type": "integer",
                "minimum": 0
              },
              "latest_reading_missing": {
                "type": "boolean"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "tag_id",
              "missing_samples",
              "non_good_samples",
              "latest_reading_missing",
              "evidence_ids"
            ]
          }
        },
        "retest_result_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "record_checks",
        "observed_quality",
        "retest_result_ids"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "request"
        },
        "agent": {
          "const": "inspection_quality_documentation"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "urn:verum:agents:v1:common#/$defs/context"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/evidence"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inspection_results": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:agents:v1:common#/$defs/inspection_result"
              }
            },
            "result_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "catalog": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:agents:v1:common#/$defs/catalog_action"
              }
            },
            "catalog_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "process_coverage": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:agents:v1:common#/$defs/coverage"
              }
            },
            "observations": {
              "anyOf": [
                {
                  "$ref": "urn:verum:agents:v1:common#/$defs/observations"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inspection_requests": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:inspection_request:0.5.0"
              }
            }
          },
          "required": [
            "inspection_results",
            "result_evidence_ids",
            "catalog",
            "catalog_evidence_ids",
            "process_coverage",
            "observations",
            "inspection_requests"
          ]
        }
      },
      "required": [
        "interface_version",
        "message_type",
        "agent",
        "request_id",
        "context",
        "evidence",
        "input"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "response"
        },
        "agent": {
          "const": "inspection_quality_documentation"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "urn:verum:agents:v1:common#/$defs/context"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "feature_profile_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version",
            "artifact_sha256",
            "feature_profile_id"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "degraded",
            "insufficient_evidence",
            "error"
          ]
        },
        "consumed_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/issue"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "advisory_only": {
          "const": true
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "record_checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "result_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "checks": {
                        "type": "array",
                        "items": {
                          "$ref": "urn:verum:agents:v1:common#/$defs/check"
                        }
                      },
                      "measurement_usable": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "scope_supported": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "equipment_condition_confirmed": {
                        "const": false
                      },
                      "evidence_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "result_id",
                      "checks",
                      "measurement_usable",
                      "scope_supported",
                      "equipment_condition_confirmed",
                      "evidence_ids"
                    ]
                  }
                },
                "observed_quality": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "tag_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "missing_samples": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "non_good_samples": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "latest_reading_missing": {
                        "type": "boolean"
                      },
                      "evidence_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "tag_id",
                      "missing_samples",
                      "non_good_samples",
                      "latest_reading_missing",
                      "evidence_ids"
                    ]
                  }
                },
                "retest_result_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "record_checks",
                "observed_quality",
                "retest_result_ids"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "interface_version",
        "message_type",
        "agent",
        "request_id",
        "report_id",
        "context",
        "implementation",
        "status",
        "consumed_evidence_ids",
        "issues",
        "limitations",
        "advisory_only",
        "result"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "degraded"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "record_checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "result_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "checks": {
                          "type": "array",
                          "items": {
                            "$ref": "urn:verum:agents:v1:common#/$defs/check"
                          }
                        },
                        "measurement_usable": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "scope_supported": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "equipment_condition_confirmed": {
                          "const": false
                        },
                        "evidence_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "result_id",
                        "checks",
                        "measurement_usable",
                        "scope_supported",
                        "equipment_condition_confirmed",
                        "evidence_ids"
                      ]
                    }
                  },
                  "observed_quality": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "tag_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "missing_samples": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "non_good_samples": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "latest_reading_missing": {
                          "type": "boolean"
                        },
                        "evidence_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "tag_id",
                        "missing_samples",
                        "non_good_samples",
                        "latest_reading_missing",
                        "evidence_ids"
                      ]
                    }
                  },
                  "retest_result_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "record_checks",
                  "observed_quality",
                  "retest_result_ids"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "insufficient_evidence",
                  "error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
