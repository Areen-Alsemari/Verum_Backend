{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verum:agents:v1:historical_asset_intelligence",
  "title": "Historical & Asset Intelligence interface v1",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/asset"
          }
        },
        "declared_facts": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/fact"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:inspection_history:0.7.0"
          }
        },
        "reference_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "query_asset_ids",
        "assets",
        "declared_facts",
        "history",
        "reference_evidence_ids"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_records": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/asset"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/fact"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:inspection_history:0.7.0"
          }
        },
        "history_status": {
          "enum": [
            "no_verified_past_maintenance_supplied",
            "simulated_records_available",
            "unknown"
          ]
        },
        "missing_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "asset_records",
        "facts",
        "history",
        "history_status",
        "missing_asset_ids",
        "evidence_ids"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "request"
        },
        "agent": {
          "const": "historical_asset_intelligence"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "urn:verum:agents:v1:common#/$defs/context"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/evidence"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query_asset_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "assets": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:agents:v1:common#/$defs/asset"
              }
            },
            "declared_facts": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:agents:v1:common#/$defs/fact"
              }
            },
            "history": {
              "type": "array",
              "items": {
                "$ref": "urn:verum:inspection_history:0.7.0"
              }
            },
            "reference_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "query_asset_ids",
            "assets",
            "declared_facts",
            "history",
            "reference_evidence_ids"
          ]
        }
      },
      "required": [
        "interface_version",
        "message_type",
        "agent",
        "request_id",
        "context",
        "evidence",
        "input"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "response"
        },
        "agent": {
          "const": "historical_asset_intelligence"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "urn:verum:agents:v1:common#/$defs/context"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "feature_profile_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version",
            "artifact_sha256",
            "feature_profile_id"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "degraded",
            "insufficient_evidence",
            "error"
          ]
        },
        "consumed_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/issue"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "advisory_only": {
          "const": true
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "asset_records": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:verum:agents:v1:common#/$defs/asset"
                  }
                },
                "facts": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:verum:agents:v1:common#/$defs/fact"
                  }
                },
                "history": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:verum:inspection_history:0.7.0"
                  }
                },
                "history_status": {
                  "enum": [
                    "no_verified_past_maintenance_supplied",
                    "simulated_records_available",
                    "unknown"
                  ]
                },
                "missing_asset_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "asset_records",
                "facts",
                "history",
                "history_status",
                "missing_asset_ids",
                "evidence_ids"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "interface_version",
        "message_type",
        "agent",
        "request_id",
        "report_id",
        "context",
        "implementation",
        "status",
        "consumed_evidence_ids",
        "issues",
        "limitations",
        "advisory_only",
        "result"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "degraded"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "asset_records": {
                    "type": "array",
                    "items": {
                      "$ref": "urn:verum:agents:v1:common#/$defs/asset"
                    }
                  },
                  "facts": {
                    "type": "array",
                    "items": {
                      "$ref": "urn:verum:agents:v1:common#/$defs/fact"
                    }
                  },
                  "history": {
                    "type": "array",
                    "items": {
                      "$ref": "urn:verum:inspection_history:0.7.0"
                    }
                  },
                  "history_status": {
                    "enum": [
                      "no_verified_past_maintenance_supplied",
                      "simulated_records_available",
                      "unknown"
                    ]
                  },
                  "missing_asset_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "asset_records",
                  "facts",
                  "history",
                  "history_status",
                  "missing_asset_ids",
                  "evidence_ids"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "insufficient_evidence",
                  "error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
