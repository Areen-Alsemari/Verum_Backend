{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verum:agents:v1:predictive_health",
  "title": "Predictive Health interface v1",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observations": {
          "$ref": "urn:verum:agents:v1:common#/$defs/observations"
        },
        "target_tag_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forecast_horizon_s": {
          "const": 300.0
        }
      },
      "required": [
        "observations",
        "target_tag_ids",
        "forecast_horizon_s"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forecasts": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/forecast"
          }
        },
        "health_score": {
          "type": "null"
        },
        "remaining_useful_life": {
          "type": "null"
        },
        "field_qualified": {
          "const": false
        }
      },
      "required": [
        "forecasts",
        "health_score",
        "remaining_useful_life",
        "field_qualified"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "request"
        },
        "agent": {
          "const": "predictive_health"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "urn:verum:agents:v1:common#/$defs/context"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/evidence"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observations": {
              "$ref": "urn:verum:agents:v1:common#/$defs/observations"
            },
            "target_tag_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "forecast_horizon_s": {
              "const": 300.0
            }
          },
          "required": [
            "observations",
            "target_tag_ids",
            "forecast_horizon_s"
          ]
        }
      },
      "required": [
        "interface_version",
        "message_type",
        "agent",
        "request_id",
        "context",
        "evidence",
        "input"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "response"
        },
        "agent": {
          "const": "predictive_health"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "urn:verum:agents:v1:common#/$defs/context"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "feature_profile_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version",
            "artifact_sha256",
            "feature_profile_id"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "degraded",
            "insufficient_evidence",
            "error"
          ]
        },
        "consumed_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:verum:agents:v1:common#/$defs/issue"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "advisory_only": {
          "const": true
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "forecasts": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:verum:agents:v1:common#/$defs/forecast"
                  }
                },
                "health_score": {
                  "type": "null"
                },
                "remaining_useful_life": {
                  "type": "null"
                },
                "field_qualified": {
                  "const": false
                }
              },
              "required": [
                "forecasts",
                "health_score",
                "remaining_useful_life",
                "field_qualified"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "interface_version",
        "message_type",
        "agent",
        "request_id",
        "report_id",
        "context",
        "implementation",
        "status",
        "consumed_evidence_ids",
        "issues",
        "limitations",
        "advisory_only",
        "result"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "degraded"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "forecasts": {
                    "type": "array",
                    "items": {
                      "$ref": "urn:verum:agents:v1:common#/$defs/forecast"
                    }
                  },
                  "health_score": {
                    "type": "null"
                  },
                  "remaining_useful_life": {
                    "type": "null"
                  },
                  "field_qualified": {
                    "const": false
                  }
                },
                "required": [
                  "forecasts",
                  "health_score",
                  "remaining_useful_life",
                  "field_qualified"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "insufficient_evidence",
                  "error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
